  "designDecisions": [
    {
      "decision": "Do not persist a new input snapshot before Telegram succeeds.",
      "reason": "This prevents a failed same-day attempt from binding an old report to a new input.",
      "status": "verified"
    },
    {
      "decision": "Allow a same-date pending archive to replace older data only after CLI identity verification.",
      "reason": "A successful archive/data push gap must recover the latest canonical update without a second Telegram send.",
